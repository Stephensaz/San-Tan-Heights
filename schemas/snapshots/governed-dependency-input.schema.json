{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sth://schemas/snapshots/governed-dependency-input-v1",
  "type":"object","additionalProperties":false,
  "required":["dependency_type","dependency_id","semantic_fingerprint","record_fingerprint","dependency_version","required","variant_scope"],
  "properties":{
    "dependency_type":{"type":"string","minLength":1},
    "dependency_id":{"type":"string","minLength":1},
    "semantic_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "record_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "dependency_version":{"type":"string","minLength":1},
    "required":{"type":"boolean"},
    "variant_scope":{"type":"array","items":{"type":"string","enum":["AGENT","SELLER","PUBLIC"]},"uniqueItems":true}
  }
}
