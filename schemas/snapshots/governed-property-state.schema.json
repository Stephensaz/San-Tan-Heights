{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"sth://schemas/snapshots/governed-property-state-v1",
  "type":"object","additionalProperties":false,
  "required":["property_id","governed_state_version","source_read_token","intelligence_schema_version","governance_schema_version","model_version","property_identity_status","qa_status","findings","dependencies"],
  "properties":{
    "property_id":{"type":"string","format":"uuid"},
    "governed_state_version":{"type":"string","minLength":1},
    "source_read_token":{"type":"string","minLength":1},
    "intelligence_schema_version":{"type":"string","minLength":1},
    "governance_schema_version":{"type":"string","minLength":1},
    "model_version":{"type":"string","minLength":1},
    "property_identity_status":{"type":"string","enum":["RESOLVED","BLOCKED","INVALID"]},
    "qa_status":{"type":"string","enum":["PENDING","PASS","FAIL","REVIEW_REQUIRED"]},
    "findings":{"type":"array","items":{"$ref":"governed-finding-input.schema.json"}},
    "dependencies":{"type":"array","items":{"$ref":"governed-dependency-input.schema.json"}}
  }
}
